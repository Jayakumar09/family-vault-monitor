{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "types": ["node", "@playwright/test"],
    "noEmit": true
  },
  "include": [
  "tests/**/*.ts",
  "pages/**/*.ts",
  "config/**/*.ts",
  "utils/**/*.ts",
  "scripts/**/*.ts",
  "playwright.config.ts"
]
}